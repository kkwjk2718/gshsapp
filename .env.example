# Required for Prisma (SQLite local DB)
# For server Docker deployment, use: file:/app/data/dev.db
DATABASE_URL="file:./dev.db"

# Required for next-auth session encryption/signing
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional app/base URL (used by sitemap/robots)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional trusted-proxy client IP boundary for application rate limits.
# Leave empty unless the reverse proxy strips every inbound copy of this header
# and overwrites it with exactly one validated client IP address. Without this
# invariant, x-forwarded-for/x-real-ip are ignored and clients share a fail-closed
# unknown-IP bucket. Prefer a dedicated header such as x-gshs-client-ip.
TRUSTED_CLIENT_IP_HEADER=""

# Optional external integrations (leave empty for local/offline mode)
# Google Analytics is configured from /admin/settings.
NEXT_PUBLIC_NEIS_API_KEY=""
