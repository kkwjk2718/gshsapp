# Required for Prisma (SQLite local DB)
# For server Docker deployment, use: file:/app/data/dev.db
DATABASE_URL="file:./dev.db"

# Required for next-auth session encryption/signing
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional app/base URL (used by sitemap/robots)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Number of right-most X-Forwarded-For entries added by trusted proxies (0-3).
# Default 0 ignores forwarding headers and uses the shared unknown-client bucket.
# Set only when every hop is controlled and strips untrusted forwarding headers.
TRUSTED_PROXY_HOPS="0"

# Optional external integrations (leave empty for local/offline mode)
# Google Analytics is configured from /admin/settings.
NEXT_PUBLIC_NEIS_API_KEY=""
