# All mutable file paths are resolved below this root.
# Production Docker sets this to /app/data. The local default is <project>/prisma.
DATA_ROOT=""

# Required for Prisma (SQLite local DB). Relative file URLs are resolved below DATA_ROOT.
# For server Docker deployment, use: file:/app/data/dev.db
DATABASE_URL="file:./dev.db"

# Optional relative paths below DATA_ROOT.
BACKUP_DIR="backup"
RESTORE_ROOT="restore"
BACKUP_RETENTION_MIN_GENERATIONS="3"
BACKUP_RETENTION_MAX_GENERATIONS="30"
BACKUP_RETENTION_MAX_AGE_DAYS="90"
BACKUP_RETENTION_MAX_TOTAL_BYTES="21474836480"
BACKUP_RESERVE_FREE_BYTES="268435456"
BACKUP_STALE_WORK_MAX_AGE_HOURS="24"
RESTORE_MAX_UPLOAD_BYTES="134217728"
WEATHER_CACHE_PATH="weather-cache.json"

# Required for next-auth session encryption/signing
AUTH_SECRET=""

# Optional app/base URL (used by sitemap/robots)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Exact number of right-most X-Forwarded-For entries added by controlled proxies.
# Production requires 1-3 and every hop must overwrite untrusted forwarding headers.
# Local development without a reverse proxy may explicitly use 0.
TRUSTED_PROXY_HOPS="1"

# Optional external integrations (leave empty for local/offline mode)
# Google Analytics is configured from /admin/settings.
NEXT_PUBLIC_NEIS_API_KEY=""
ICAL_ALLOWED_HOSTS="calendar.google.com"
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="GSHS.app"

# One-time, create-only administrator bootstrap. Leave unset during normal runtime.
BOOTSTRAP_ADMIN_USER_ID=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
